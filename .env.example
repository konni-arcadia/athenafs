# Copy to .env and adjust. Every setting is optional.
# DATA=/absolute/path          # where runtime data lives (cache, state, mount point). Default: ./data
ATHENAFS_BIND=127.0.0.1        # 0.0.0.0 opens the web page to the local network (it has no password)
ATHENAFS_PORT=8080
# ATHENAFS_PAGE_URL=http://myhost.local:8080/   # address of the page in the links at the root of the share
ATHENAFS_ARCHIVES=off          # on: zip/7z/rar open as folders (expensive to browse, see docs/findings.md)
SMB_BIND=127.0.0.1             # 0.0.0.0 shares on the local network
SMB_PORT=445
SMB_USER=tor                   # test credentials, change them for anything exposed
SMB_PASS=rent
