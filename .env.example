# Copy to .env and adjust. Every setting is optional.
# DATA=/absolute/path          # where runtime data lives (cache, state, mount point). Default: ./data
ATHENAFS_BIND=127.0.0.1        # 0.0.0.0 opens the web page to the local network (no password unless ATHENAFS_PASSWORD)
ATHENAFS_PORT=8080
# ATHENAFS_PASSWORD=             # page and API password (basic auth, user "admin"); empty = no password
# ATHENAFS_PAGE_URL=http://myhost.local:8080/   # address of the page in the links at the root of the share
# ATHENAFS_SMB_HOST=myhost.local # host name in the smb:// and \\host\share locations of the API (default: the page's host)
# ATHENAFS_EXTRA_TRACKERS=udp://tracker.example:1337/announce   # comma-separated; added to magnets with no tracker
# ATHENAFS_ADD_TIMEOUT=10        # s the mount waits for a magnet's metadata (default: core/config.yaml)
# ATHENAFS_READ_TIMEOUT=60       # s before a stuck read returns an error (default: core/config.yaml)
ATHENAFS_DORMANT_AFTER=600     # a torrent leaves the BitTorrent client after this many s without an open file; 0 = never
ATHENAFS_HEALTH_PROBE=60       # health check: wake each dormant torrent this many s in turn to count its peers; 0 = off
ATHENAFS_HEALTH_PARALLEL=2
ATHENAFS_GENTLEMAN=on           # help torrents in difficulty: download their rarest pieces and seed them (page: Settings)
ATHENAFS_GENTLEMAN_SLOTS=3     # torrents helped at a time, at most (each keeps one torrent awake)
ATHENAFS_GENTLEMAN_SPACE_PCT=5 # part of the cache cap reserved for them (a separate cache)
ATHENAFS_AWAKE_MEMORY_MB=2000  # torrents kept awake by choice (waiting cache requests, then gentleman), about 3.5 kB a piece
ATHENAFS_MEMORY_CEILING_MB=8000 # above this real memory of Distribyted, those torrents are put back to sleep
ATHENAFS_UPLOAD_LIMIT_KBPS=1000   # upload cap for everything, kB/s; 0 = none
ATHENAFS_ARCHIVES=off          # on: zip/7z/rar open as folders (expensive to browse, see docs/findings.md)
SMB_BIND=127.0.0.1             # 0.0.0.0 shares on the local network
SMB_PORT=445
SMB_SHARE=torrents             # name of the share
SMB_USER=tor                   # test credentials, change them for anything exposed
SMB_PASS=rent
