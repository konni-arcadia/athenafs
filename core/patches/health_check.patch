+// Probe wakes the torrent for d without opening any file (nothing is downloaded: no file asks for data), calling sample
+// every few seconds, then puts it back to sleep at once if it was dormant before and no file was opened meanwhile.
+func (l *Lazy) Probe(d time.Duration, sample func(*torrent.Torrent)) error {
+	l.mu.Lock()
+	wasAsleep := l.t == nil
+	if wasAsleep {
+		t, err := l.wake(l)
+		if err != nil {
+			l.mu.Unlock()
+			return err
+		}
+		l.t = t
+	}
+	l.open++ // holds it awake
+	t := l.t
+	l.mu.Unlock()
+
+	end := time.Now().Add(d)
+	for time.Now().Before(end) {
+		time.Sleep(5 * time.Second)
+		sample(t)
+	}
+
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.open--
+	if wasAsleep && l.open == 0 && l.t != nil {
+		l.drop(l, l.t)
+		l.t = nil
+	}
+	return nil
+}
