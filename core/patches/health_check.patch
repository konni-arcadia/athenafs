+// healthChecks wakes the dormant torrents in turn, a few at a time, for $DISTRIBYTED_HEALTH_PROBE seconds each (0 = off),
+// and records the most peers and seeders seen. Order: the info-hashes listed in $DISTRIBYTED_HEALTH_ORDER (one per
+// line, the supervisor puts the never or least recently checked first), then the others; then again, round after round.
+func (s *Service) healthChecks() {
+	probe, _ := strconv.Atoi(os.Getenv("DISTRIBYTED_HEALTH_PROBE"))
+	parallel, _ := strconv.Atoi(os.Getenv("DISTRIBYTED_HEALTH_PARALLEL"))
+	if probe <= 0 {
+		return
+	}
+	if parallel <= 0 {
+		parallel = 1
+	}
+	time.Sleep(2 * time.Minute) // let the start-up settle
+	sem := make(chan struct{}, parallel)
+	for {
+		order := map[string]int{}
+		if b, err := os.ReadFile(os.Getenv("DISTRIBYTED_HEALTH_ORDER")); err == nil {
+			for i, h := range strings.Fields(string(b)) {
+				order[h] = i + 1
+			}
+		}
+		s.lazyMu.Lock()
+		ls := append([]*fs.Lazy(nil), s.lazies...)
+		s.lazyMu.Unlock()
+		rank := func(l *fs.Lazy) int {
+			if r, ok := order[l.Hash]; ok {
+				return r
+			}
+			return len(order) + 1
+		}
+		sort.SliceStable(ls, func(i, j int) bool { return rank(ls[i]) < rank(ls[j]) })
+		var wg sync.WaitGroup
+		for _, l := range ls {
+			if l.Awake() { // being read: its stats are live anyway
+				continue
+			}
+			sem <- struct{}{}
+			wg.Add(1)
+			go func(l *fs.Lazy) {
+				defer func() { <-sem; wg.Done() }()
+				h := &Health{}
+				err := l.Probe(time.Duration(probe)*time.Second, func(t *torrent.Torrent) {
+					st := t.Stats()
+					h.Known = max(h.Known, st.TotalPeers)
+					h.Connected = max(h.Connected, st.ActivePeers)
+					h.Seeders = max(h.Seeders, st.ConnectedSeeders)
+				})
+				if err != nil {
+					s.log.Warn().Err(err).Str("hash", l.Hash).Msg("health check failed")
+					return
+				}
+				h.Checked = time.Now().Unix()
+				s.s.SetHealth(l.Hash, h)
+			}(l)
+		}
+		wg.Wait()
+		s.log.Info().Int("torrents", len(ls)).Msg("health check round done")
+	}
+}
