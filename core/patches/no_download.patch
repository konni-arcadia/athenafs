new file mode 100644
index 0000000..1d0f12e
--- /dev/null
+++ b/fs/nodownload.go
@@ -0,0 +1,17 @@
+package fs
+
+import "sync/atomic"
+
+// NoDownload is set while caching is stopped from the page ($DISTRIBYTED_NO_DOWNLOAD_FILE exists, see
+// torrent/nodownload.go): no torrent downloads data, and a read that needs data not in the cache fails after
+// NoDownloadTimeout seconds instead of the read timeout. Data already in the cache is read from the disk well within it.
+var NoDownload atomic.Bool
+
+const NoDownloadTimeout = 2
+
+func readTimeout(t int) int {
+	if NoDownload.Load() && t > NoDownloadTimeout {
+		return NoDownloadTimeout
+	}
+	return t
+}
