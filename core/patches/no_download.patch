diff --git a/torrent/nodownload.go b/torrent/nodownload.go
new file mode 100644
index 0000000..a092291
--- /dev/null
+++ b/torrent/nodownload.go
@@ -0,0 +1,44 @@
+package torrent
+
+import (
+	"os"
+	"time"
+
+	"github.com/anacrolix/torrent"
+
+	"github.com/distribyted/distribyted/fs"
+)
+
+// Caching stopped from the page: while $DISTRIBYTED_NO_DOWNLOAD_FILE exists, no torrent downloads data. Checked every
+// 5 s: while stopped, every awake torrent is told again (a torrent woken meanwhile is told at its wake too); when it
+// stops, every awake torrent may download again. What is in the cache is still read and served.
+func (s *Service) noDownloadLoop(file string) {
+	for {
+		_, err := os.Stat(file)
+		on := err == nil
+		changed := on != fs.NoDownload.Load()
+		fs.NoDownload.Store(on)
+		if changed {
+			s.log.Info().Bool("stopped", on).Msg("caching stopped or resumed from the page")
+		}
+		if on || changed {
+			s.lazyMu.Lock()
+			ls := append([]*fs.Lazy(nil), s.lazies...)
+			s.lazyMu.Unlock()
+			for _, l := range ls {
+				if t := l.Current(); t != nil {
+					applyNoDownload(t)
+				}
+			}
+		}
+		time.Sleep(5 * time.Second)
+	}
+}
+
+func applyNoDownload(t *torrent.Torrent) {
+	if fs.NoDownload.Load() {
+		t.DisallowDataDownload()
+	} else {
+		t.AllowDataDownload()
+	}
+}
