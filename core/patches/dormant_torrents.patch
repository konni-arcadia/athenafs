new file mode 100644
index 0000000..281bb25
--- /dev/null
+++ b/fs/lazy.go
@@ -0,0 +1,104 @@
+package fs
+
+import (
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/anacrolix/torrent"
+	"github.com/anacrolix/torrent/metainfo"
+)
+
+// Lazy is a torrent served from its metadata alone: its files are listed without the BitTorrent client, and the torrent
+// is added to the client ("woken") only when one of its files is opened. Sleep takes it out again once no file has been
+// open for a while. Hundreds of torrents then cost only what the few being read cost (peers, announces, memory).
+type Lazy struct {
+	Hash  string
+	Info  *metainfo.Info
+	Route string
+
+	wake  func(*Lazy) (*torrent.Torrent, error)
+	drop  func(*Lazy, *torrent.Torrent)
+	mu    sync.Mutex
+	t     *torrent.Torrent
+	open  int
+	since time.Time // last open or close
+}
+
+func NewLazy(hash, route string, info *metainfo.Info, wake func(*Lazy) (*torrent.Torrent, error),
+	drop func(*Lazy, *torrent.Torrent)) *Lazy {
+	return &Lazy{Hash: hash, Route: route, Info: info, wake: wake, drop: drop}
+}
+
+// lazyFile is one file of the torrent, as anacrolix's Torrent.Files() would list it (same order, same paths).
+type lazyFile struct {
+	path, displayPath string
+	length            int64
+	index             int
+}
+
+func (l *Lazy) files() []lazyFile {
+	var out []lazyFile
+	for i, fi := range l.Info.UpvertedFiles() {
+		out = append(out, lazyFile{
+			path:        strings.Join(append([]string{l.Info.BestName()}, fi.BestPath()...), "/"),
+			displayPath: fi.DisplayPath(l.Info),
+			length:      fi.Length,
+			index:       i,
+		})
+	}
+	return out
+}
+
+// reader wakes the torrent if needed and opens file i of it.
+func (l *Lazy) reader(i int) (torrent.Reader, error) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.t == nil {
+		t, err := l.wake(l)
+		if err != nil {
+			return nil, err
+		}
+		l.t = t
+	}
+	l.open++
+	l.since = time.Now()
+	return &lazyReader{Reader: l.t.Files()[i].NewReader(), l: l}, nil
+}
+
+// SleepIfIdle takes the torrent out of the client when it is awake, no file of it is open, and the last open or close
+// was more than idle ago. Returns true when it went to sleep.
+func (l *Lazy) SleepIfIdle(idle time.Duration) bool {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.t == nil || l.open > 0 || time.Since(l.since) < idle {
+		return false
+	}
+	l.drop(l, l.t)
+	l.t = nil
+	return true
+}
+
+// Awake reports whether the torrent is in the client now.
+func (l *Lazy) Awake() bool {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.t != nil
+}
+
+type lazyReader struct {
+	torrent.Reader
+	l    *Lazy
+	once sync.Once
+}
+
+func (r *lazyReader) Close() error {
+	err := r.Reader.Close()
+	r.once.Do(func() {
+		r.l.mu.Lock()
+		r.l.open--
+		r.l.since = time.Now()
+		r.l.mu.Unlock()
+	})
+	return err
+}
