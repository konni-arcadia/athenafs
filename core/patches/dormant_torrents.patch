+	if dormantAfter > 0 {
+		go s.sleepIdle()
+	}
+	return s
+}
+
+// sleepIdle puts back to sleep the woken torrents that have had no open file for dormantAfter.
+func (s *Service) sleepIdle() {
+	for range time.Tick(30 * time.Second) {
+		s.lazyMu.Lock()
+		ls := append([]*fs.Lazy(nil), s.lazies...)
+		s.lazyMu.Unlock()
+		for _, l := range ls {
+			if l.SleepIfIdle(s.dormantAfter) {
+				s.log.Info().Str("hash", l.Hash).Str("route", l.Route).Msg("torrent asleep (idle)")
+			}
+		}
+	}
+}
+
+func (s *Service) addLazy(r, p string) error {
+	mi, err := metainfo.LoadFromFile(p)
+	if err != nil {
+		return err
+	}
+	info, err := mi.UnmarshalInfo()
+	if err != nil {
+		return err
+	}
+	h := mi.HashInfoBytes().HexString()
+	wake := func(l *fs.Lazy) (*torrent.Torrent, error) {
+		t, err := s.c.AddTorrent(mi)
+		if err != nil {
+			return nil, err
+		}
+		s.s.ClearDormant(r, h)
+		s.s.Add(r, t)
+		s.log.Info().Str("hash", h).Str("route", r).Msg("torrent woken (a file was opened)")
+		return t, nil
+	}
+	sleep := func(l *fs.Lazy, t *torrent.Torrent) {
+		s.s.Del(r, h)
+		t.Drop()
+		s.s.SetDormant(r, h, info.BestName(), info.NumPieces(), info.PieceLength)
+	}
+	l := fs.NewLazy(h, r, &info, wake, sleep)
+
+	s.mu.Lock()
+	tfs, ok := s.fss[path.Join("/", r)].(*fs.Torrent)
+	s.mu.Unlock()
+	if !ok {
+		return errors.New("error adding torrent to filesystem")
+	}
+	s.s.SetDormant(r, h, info.BestName(), info.NumPieces(), info.PieceLength)
+	tfs.AddLazy(l)
+	s.lazyMu.Lock()
+	s.lazies = append(s.lazies, l)
+	s.lazyMu.Unlock()
+	s.log.Info().Str("name", info.BestName()).Str("route", r).Msg("torrent added (dormant)")
+	return nil
 }
 
