+
+// Gentleman mode (see torrent/gentleman.go): while gentle is set, a wake uses the gentleman cache, and Hold keeps the
+// torrent awake until Release. gentle is atomic because the wake function reads it with l.mu held.
+
+func (l *Lazy) SetGentle(on bool) { l.gentle.Store(on) }
+func (l *Lazy) Gentle() bool       { return l.gentle.Load() }
+
+// Hold wakes the torrent if needed and keeps it awake until Release.
+func (l *Lazy) Hold() (*torrent.Torrent, error) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.t == nil {
+		t, err := l.wake(l)
+		if err != nil {
+			return nil, err
+		}
+		l.t = t
+	}
+	l.open++
+	l.since = time.Now()
+	return l.t, nil
+}
+
+// Release ends a Hold; the torrent then sleeps after the usual idle delay.
+func (l *Lazy) Release() {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.open > 0 {
+		l.open--
+	}
+	l.since = time.Now()
+}
diff --git a/torrent/gentleman.go b/torrent/gentleman.go
new file mode 100644
index 0000000..5ae2105
--- /dev/null
+++ b/torrent/gentleman.go
@@ -0,0 +1,155 @@
+package torrent
+
+import (
+	"encoding/json"
+	"os"
+	"sort"
+	"time"
+
+	"github.com/anacrolix/torrent"
+	"github.com/anacrolix/torrent/storage"
+
+	"github.com/distribyted/distribyted/fs"
+)
+
+// Gentleman mode: help torrents in difficulty (few seeders, leechers waiting) by downloading their rarest pieces into a
+// cache of their own and seeding them. The supervisor chooses the torrents and the budget and writes them to
+// $DISTRIBYTED_GENTLEMAN_FILE ({"torrents": [{"hash": ..., "budget": bytes}]}), reread every minute. GentleStorage is
+// that separate cache (set in main from $DISTRIBYTED_GENTLEMAN_CACHE and $DISTRIBYTED_GENTLEMAN_SPACE): normal use
+// never evicts it and it never evicts normal use. Only dormant torrents are taken (an awake one uses the normal cache).
+
+var GentleStorage storage.ClientImpl
+
+type gentleConf struct {
+	Torrents []struct {
+		Hash   string `json:"hash"`
+		Budget int64  `json:"budget"`
+	} `json:"torrents"`
+}
+
+type gentleJob struct {
+	l      *fs.Lazy
+	t      *torrent.Torrent
+	budget int64
+	stop   chan struct{}
+}
+
+func (s *Service) gentlemanLoop(file string) {
+	jobs := map[string]*gentleJob{}
+	for range time.Tick(time.Minute) {
+		var c gentleConf
+		if b, err := os.ReadFile(file); err == nil {
+			_ = json.Unmarshal(b, &c)
+		}
+		want := map[string]int64{}
+		for _, x := range c.Torrents {
+			want[x.Hash] = x.Budget
+		}
+		for h, j := range jobs { // released by the supervisor
+			if _, ok := want[h]; !ok {
+				close(j.stop)
+				delete(jobs, h)
+			}
+		}
+		if GentleStorage == nil {
+			continue
+		}
+		for h, budget := range want {
+			if j, ok := jobs[h]; ok {
+				j.budget = budget
+				continue
+			}
+			l := s.lazyByHash(h)
+			if l == nil || l.Awake() {
+				continue // unknown, or in use with the normal cache: try again later
+			}
+			l.SetGentle(true)
+			t, err := l.Hold()
+			if err != nil {
+				l.SetGentle(false)
+				continue
+			}
+			j := &gentleJob{l: l, t: t, budget: budget, stop: make(chan struct{})}
+			jobs[h] = j
+			s.log.Info().Str("hash", h).Int64("budget", budget).Msg("gentleman: helping this torrent")
+			go s.gentleRun(h, j)
+		}
+	}
+}
+
+func (s *Service) lazyByHash(h string) *fs.Lazy {
+	s.lazyMu.Lock()
+	defer s.lazyMu.Unlock()
+	for _, l := range s.lazies {
+		if l.Hash == h {
+			return l
+		}
+	}
+	return nil
+}
+
+// gentleRun asks for one piece so that the torrent connects to its peers, then every 2 minutes counts which connected
+// peers have which piece and asks for the rarest ones it does not have yet, until the budget is used.
+func (s *Service) gentleRun(h string, j *gentleJob) {
+	t := j.t
+	defer func() {
+		t.CancelPieces(0, t.NumPieces())
+		j.l.SetGentle(false) // the next wake (after it sleeps) uses the normal cache again
+		j.l.Release()
+		s.s.SetGentle(h, nil)
+		s.log.Info().Str("hash", h).Msg("gentleman: slot released")
+	}()
+	<-t.GotInfo()
+	n := t.NumPieces()
+	pl := t.Info().PieceLength
+	t.Piece(n / 2).SetPriority(torrent.PiecePriorityNormal) // something to want, so that peers are contacted
+	wanted := map[int]bool{n / 2: true}
+	tick := time.NewTicker(2 * time.Minute)
+	defer tick.Stop()
+	for {
+		avail := make([]int, n)
+		peers := 0
+		for _, pc := range t.PeerConns() {
+			bm := pc.PeerPieces()
+			if bm == nil {
+				continue
+			}
+			peers++
+			for i := 0; i < n; i++ {
+				if bm.Contains(uint32(i)) {
+					avail[i]++
+				}
+			}
+		}
+		complete := 0
+		for i := 0; i < n; i++ {
+			if t.Piece(i).State().Complete {
+				complete++
+			}
+		}
+		if peers > 0 && int64(len(wanted))*pl < j.budget {
+			var cand []int
+			for i := 0; i < n; i++ {
+				if avail[i] > 0 && !wanted[i] && !t.Piece(i).State().Complete {
+					cand = append(cand, i)
+				}
+			}
+			sort.SliceStable(cand, func(a, b int) bool { return avail[cand[a]] < avail[cand[b]] })
+			for _, i := range cand {
+				if int64(len(wanted)+1)*pl > j.budget {
+					break
+				}
+				t.Piece(i).SetPriority(torrent.PiecePriorityNormal)
+				wanted[i] = true
+			}
+		}
+		st := t.Stats()
+		s.s.SetGentle(h, &Gentle{Budget: j.budget, Wanted: len(wanted), Complete: complete, PieceSize: pl,
+			Peers: peers, Seeders: st.ConnectedSeeders, Uploaded: st.BytesWrittenData.Int64()})
+		select {
+		case <-j.stop:
+			return
+		case <-tick.C:
+		}
+	}
+}
