+// SetWokeGentle records which cache the wake function used (called by it).
+func (l *Lazy) SetWokeGentle(on bool) { l.wokeGentle.Store(on) }
+
+// HoldNormal is Hold on the normal cache: it fails while the torrent is, or is awake on, the gentleman cache.
+func (l *Lazy) HoldNormal() (*torrent.Torrent, error) {
+	l.mu.Lock()
+	busy := l.Gentle() || (l.t != nil && l.wokeGentle.Load())
+	l.mu.Unlock()
+	if busy {
+		return nil, errGentle
+	}
+	return l.Hold()
+}
+
+var errGentle = errors.New("torrent on the gentleman cache")
+
