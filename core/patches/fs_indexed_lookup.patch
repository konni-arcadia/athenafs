+func (s *storage) getFileFromFs(p string) (File, error) {
+	if fs, fsp, ok := s.fsFor(p); ok {
+		return fs.Open(separator + strings.TrimPrefix(p, fsp))
+	}
 
 	return nil, os.ErrNotExist
 }
 
