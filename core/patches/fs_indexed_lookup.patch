+// fsFor finds the filesystem mounted at p or at the nearest parent of p, walking up the path (a few map lookups) instead
+// of scanning every filesystem: with many archives or routes the scan made each lookup cost as many steps as there were
+// filesystems (the share root stopped answering with 447,000 archives).
+func (s *storage) fsFor(p string) (Filesystem, string, bool) {
+	for q := p; ; q = path.Dir(q) {
+		if fs, ok := s.filesystems[q]; ok && underFs(p, q) {
+			return fs, q, true
+		}
+		if q == separator || q == "." || q == "" {
+			return nil, "", false
 		}
 	}
+}
